rules_version = '2';

// Resonance — client-direct Firestore access.
// Update this file then deploy from firebase/:
//   firebase deploy --only firestore:rules
//
// The rules are the only thing between a signed-in client and the database:
// the repo and the web config are public, so assume any write shape a client
// could send. Anything that reaches another person — publishing, pen names,
// messages, notes, most bells — goes through the server (/api/v1, Admin SDK),
// which re-checks what it needs; the client-side paths below are the author's
// own documents plus a few narrowly checked legacy ones.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function connectedTo(userId) {
      return signedIn()
        && exists(/databases/$(database)/documents/connections/$(request.auth.uid < userId ? request.auth.uid + "_" + userId : userId + "_" + request.auth.uid));
    }

    // A card is its author's; anyone else sees it once it is published, and
    // then only as its visibility allows. (Drafts start as "public": that is
    // the choice they will be published with, not permission to read them.)
    function cardVisible(data) {
      return (signedIn() && data.authorId == request.auth.uid)
        || (
          data.publishedAt != null
          && (
            data.visibility == "public"
            || (signedIn() && data.visibility == "connections" && connectedTo(data.authorId))
          )
        );
    }

    // Either side has blocked the other (users/{uid}/blocks/{otherUid}). Every
    // way of reaching someone — connecting, messaging, inviting, notes,
    // notifications, card links — is refused across a block, in both
    // directions. get()/exists() here bypass read rules, so a user's private
    // block list can still gate what others write.
    function blockedBetween(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/blocks/$(b))
        || exists(/databases/$(database)/documents/users/$(b)/blocks/$(a));
    }

    // The fields an update changes (only meaningful on update).
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // A string field that is absent, or no longer than `max`.
    function optionalString(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    // --- users ---
    // Profiles are public on this storytelling platform (author bylines, public
    // profile pages, and feeds are viewable by logged-out visitors). Firestore
    // rules cannot redact individual fields, so the user doc must hold no
    // secret: any real PII must live in a separate owner-only doc/subcollection
    // if ever added.
    //
    // The pen name is the address of a profile page and of a conversation, so
    // it must be unique — which only a transaction can guarantee. Creating a
    // profile and changing the pen name are therefore the server's
    // (POST / PATCH /api/v1/me), and so is `verified`. The client keeps the
    // fields that name no one else.
    match /users/{userId} {
      allow create: if false;
      allow get: if true;
      // List is required for public profile lookups (where handleLower == ?).
      allow list: if true;
      allow update: if isSelf(userId)
        && changedKeys().hasOnly([
          "bio",
          "region",
          "primaryLocale",
          "autoTranslateTo",
          "avatarSeed",
          "avatarUrl",
          "initials",
          "accentColor",
          "hintsSeen"
        ])
        && validProfileChanges(request.resource.data);
      allow delete: if false;

      // Only what changes is checked, so an older profile stays editable.
      function validProfileChanges(d) {
        return (!("bio" in changedKeys()) || (d.bio is string && d.bio.size() <= 80))
          && (!("region" in changedKeys()) || (d.region is string && d.region.size() <= 40))
          && (!("primaryLocale" in changedKeys()) || d.primaryLocale in ["en", "zh-TW"])
          && (!("autoTranslateTo" in changedKeys()) || (d.autoTranslateTo is list && d.autoTranslateTo.size() <= 5))
          && (!("avatarSeed" in changedKeys()) || (d.avatarSeed is string && d.avatarSeed.size() <= 40))
          && (!("avatarUrl" in changedKeys()) || (d.avatarUrl is string && d.avatarUrl.size() <= 2048 && d.avatarUrl.matches("https://.*")))
          && (!("initials" in changedKeys()) || (d.initials is string && d.initials.size() <= 8))
          && (!("accentColor" in changedKeys()) || (d.accentColor is string && d.accentColor.size() <= 60))
          && (!("hintsSeen" in changedKeys()) || (d.hintsSeen is map && d.hintsSeen.size() <= 50));
      }

      // --- bookmarks (users/{uid}/bookmarks/{cardId}) ---
      // Purely private "speak to yourself" layer: owner-only, never counted,
      // never notified, never a recommendation signal.
      match /bookmarks/{cardId} {
        allow read, write: if isSelf(userId);
      }

      // --- blocks (users/{uid}/blocks/{blockedUid}) ---
      // The owner's private block list; the blocked person is never told.
      // Enforcement lives in blockedBetween() on every write that reaches
      // another user.
      match /blocks/{blockedId} {
        allow read, delete: if isSelf(userId);
        allow create: if isSelf(userId)
          && blockedId != userId
          && request.resource.data.keys().hasOnly(["blockedUid", "createdAt"])
          && request.resource.data.blockedUid == blockedId
          && request.resource.data.createdAt == request.time;
      }
    }

    // --- cards ---
    // Reads are governed by visibility. The author writes a draft's content
    // straight from the client (web, iOS and Android alike); everything that
    // makes a card public or names it — publishedAt, the slug, the author,
    // what it answers — is fixed at creation or set by the server
    // (POST /api/v1/cards/{id}/publish), and the counters are the server's.
    match /cards/{cardId} {
      allow get: if cardVisible(resource.data);
      // Lists are either your own cards (queries scoped authorId == you) or
      // published public ones (queries filtering visibility == "public" and
      // publishedAt != null, as the feed, profiles and resonances do). A
      // connections card is opened one at a time, by get.
      allow list: if (signedIn() && resource.data.authorId == request.auth.uid)
        || (resource.data.visibility == "public" && resource.data.publishedAt != null);
      // A new draft: yours, unpublished, without a slug, stamped now, with
      // zeroed counters and an auto-generated id. A resonance must answer a
      // card you can read, with no block either way.
      allow create: if signedIn()
        && cardId.matches("^[A-Za-z0-9]{20}$")
        && request.resource.data.keys().hasOnly([
          "authorId", "thoughtCore", "story", "tags", "visibility", "anonymous",
          "media", "accentHue", "originalLocale", "referenceCardId", "translations",
          "publishedAt", "readCount", "resonanceCount", "inviteCount", "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasAll(["authorId", "thoughtCore", "story", "tags", "visibility"])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.get("publishedAt", null) == null
        && request.resource.data.readCount == 0
        && request.resource.data.resonanceCount == 0
        && request.resource.data.inviteCount == 0
        && request.resource.data.get("createdAt", request.time) == request.time
        && optionalString(request.resource.data, "originalLocale", 10)
        && (!("translations" in request.resource.data) || request.resource.data.translations.size() == 0)
        && validCardContent(request.resource.data, request.resource.data.keys())
        && answersReadableCard(request.resource.data);
      // The author edits the content. Unpublishing, re-dating, re-slugging,
      // re-attributing or re-pointing a card are not client writes.
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && changedKeys().hasOnly([
          "thoughtCore", "story", "tags", "visibility", "anonymous", "media", "accentHue", "updatedAt"
        ])
        && validCardContent(request.resource.data, changedKeys());
      // Authors may delete any of their cards (drafts and published alike) —
      // the card box has a delete action. Dangling references (cardLinks,
      // resonance referenceCardId) degrade gracefully: readers resolve the
      // missing card to null and drop it.
      allow delete: if signedIn()
        && resource.data.authorId == request.auth.uid;

      // The content fields named in `keys` (all of them on create, the
      // changed ones on update — so an older card stays editable).
      function validCardContent(d, keys) {
        return (!("thoughtCore" in keys) || (d.thoughtCore is string && d.thoughtCore.size() <= 200))
          && (!("story" in keys) || (d.story is string && d.story.size() <= 200000))
          && (!("tags" in keys) || (d.tags is list && d.tags.size() <= 30))
          && (!("visibility" in keys) || d.visibility in ["public", "connections", "private"])
          && (!("anonymous" in keys) || d.anonymous is bool)
          && (!("accentHue" in keys) || !("accentHue" in d) || d.accentHue == null || d.accentHue is number)
          && (!("media" in keys) || !("media" in d) || validMedia(d.media));
      }

      function validMedia(m) {
        return m is map
          && m.keys().hasOnly(["type", "url", "label"])
          && m.type in ["image", "video"]
          && m.url is string && m.url.size() <= 2048 && m.url.matches("https://.*")
          && (!("label" in m) || (m.label is string && m.label.size() <= 500));
      }

      function answersReadableCard(d) {
        return !("referenceCardId" in d)
          || d.referenceCardId == null
          || (d.referenceCardId is string
              && d.referenceCardId.size() <= 64
              && originalReadable(get(/databases/$(database)/documents/cards/$(d.referenceCardId)).data));
      }

      function originalReadable(original) {
        return cardVisible(original) && !blockedBetween(request.auth.uid, original.authorId);
      }

      // --- pending edits (cards/{cardId}/edits/current) ---
      // Editing an already-published card autosaves *here*, never onto the
      // live document: a half-written revision must not reach readers. The
      // author merges it into the card explicitly ("儲存修改"), which deletes
      // this doc. Owner-only — this is unpublished writing, so it cannot live
      // as a field on the card (rules cannot redact individual fields).
      match /edits/{editId} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/cards/$(cardId)).data.authorId == request.auth.uid;
      }
    }

    // --- connections ---
    // Two people are connected by a story-shaped act, and the server makes
    // it: a resonance's first publish or a note (/api/v1). The one client
    // path left is answering a legacy invite, which must accept that very
    // invite in the same transaction (its id rides along on the connection).
    // The doc id is deterministic: min(uidA, uidB) + "_" + max(...).
    function sortedConnectionId(a, b) {
      return a < b ? a + "_" + b : b + "_" + a;
    }
    function otherOf(pair) {
      return pair[0] == request.auth.uid ? pair[1] : pair[0];
    }
    // The invite is pending before this write and accepted by it, and it
    // was sent by `other` to the caller.
    function acceptsInvite(inviteId, other) {
      return inviteId is string
        && get(/databases/$(database)/documents/invites/$(inviteId)).data.status == "pending"
        && getAfter(/databases/$(database)/documents/invites/$(inviteId)).data.status == "accepted"
        && getAfter(/databases/$(database)/documents/invites/$(inviteId)).data.toUserId == request.auth.uid
        && getAfter(/databases/$(database)/documents/invites/$(inviteId)).data.fromUserId == other;
    }
    match /connections/{connectionId} {
      allow read: if signedIn() && request.auth.uid in resource.data.userIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["userIds", "establishedAt", "inviteId"])
        && request.resource.data.userIds is list
        && request.resource.data.userIds.size() == 2
        && request.auth.uid in request.resource.data.userIds
        && connectionId == sortedConnectionId(
            request.resource.data.userIds[0],
            request.resource.data.userIds[1]
          )
        && request.resource.data.establishedAt == request.time
        && !blockedBetween(request.resource.data.userIds[0], request.resource.data.userIds[1])
        && acceptsInvite(request.resource.data.inviteId, otherOf(request.resource.data.userIds));
      allow update: if false;
      // Either party may end the connection (blocking does this). The
      // conversation stays readable but frozen: only the server sends.
      allow delete: if signedIn() && request.auth.uid in resource.data.userIds;
    }

    // --- conversations (私訊) ---
    // One conversation per connection: the doc id IS the connection's sorted
    // pair id. Participants read it; the server writes it — opening it,
    // each message, the preview and the other side's unread counter all
    // happen in one transaction (POST /api/v1/messages), which re-checks the
    // connection and blocks. A participant may only zero their own unread.
    match /conversations/{conversationId} {
      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participants;
      }
      allow read: if isParticipant();
      allow create: if false;
      allow update: if isParticipant()
        && changedKeys().hasOnly(["unread"])
        && request.resource.data.unread.diff(resource.data.unread).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.unread[request.auth.uid] == 0;
      // Either participant may delete the whole conversation (the client
      // deletes the message docs first — Firestore doesn't cascade).
      allow delete: if isParticipant();

      match /messages/{messageId} {
        function parentConvo() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        allow read: if signedIn() && request.auth.uid in parentConvo().participants;
        allow create, update: if false;
        // Deletable only as part of deleting the whole conversation — by
        // either participant, not just the sender.
        allow delete: if signedIn() && request.auth.uid in parentConvo().participants;
      }
    }

    // --- invites ---
    // Sender/recipient can read and update status.
    match /invites/{inviteId} {
      allow read: if signedIn()
        && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      // Legacy: nothing sends invites any more (a resonance or a note connects
      // people), so none can be created; the pending ones are answered.
      allow create: if false;
      allow update: if signedIn()
        && resource.data.status == "pending"
        && changedKeys().hasOnly(["status"])
        && (
          // Either side may withdraw it (blocking does, in both directions)…
          ((resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid)
            && request.resource.data.status == "withdrawn")
          // …and only its recipient answers it.
          || (resource.data.toUserId == request.auth.uid
            && request.resource.data.status in ["accepted", "declined"])
        );
      allow delete: if false;
    }

    // --- resonances (legacy) ---
    // A resonance is a response card now (referenceCardId); nothing writes
    // these any more. The resonator and the card's author may still read
    // theirs, and the resonator delete it.
    match /resonances/{resonanceId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || get(/databases/$(database)/documents/cards/$(resource.data.cardId)).data.authorId == request.auth.uid
      );
      allow create, update: if false;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // --- notes (小紙條) ---
    // A private note from a reader to a card's author. No audience: only the
    // sender and the recipient can ever read it, and neither can list anyone
    // else's notes (queries must constrain on their own uid, which these
    // per-doc conditions enforce for every result). Sent by the server
    // (POST /api/v1/notes), which finds the author from the card.
    match /notes/{noteId} {
      allow read: if signedIn()
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid);
      allow create: if false;
      // The recipient may mark it read; nothing else ever changes.
      allow update: if signedIn()
        && resource.data.toUserId == request.auth.uid
        && changedKeys().hasOnly(["readAt"]);
      allow delete: if false;
    }

    // --- cardLinks ---
    // A public association from one card to another ({sourceCardId}_{targetCardId}).
    // Nothing creates them from the client any more; the existing ones stay
    // readable and their source's author may remove them.
    match /cardLinks/{linkId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if signedIn() && resource.data.sourceAuthorId == request.auth.uid;
    }

    // --- thoughtMaps ---
    // Each user's private Zettelkasten board: node positions, labeled edges
    // and category groups live in subcollections under their own uid. The map
    // is a personal organizing surface, never visible to anyone else.
    match /thoughtMaps/{userId}/{document=**} {
      allow read, write: if isSelf(userId);
    }

    // --- notifications ---
    // Recipients read their own bell and mark it read. The server writes
    // almost every row (resonance, note, message, …) and pushes it. The one
    // client-written kind left is the legacy "invite_accepted", checked to
    // the field: the sender's real pen name, stamped now, and only in the
    // transaction that accepts that invite.
    function inviteAcceptedBell(d) {
      return d.type == "invite_accepted"
        && d.keys().hasOnly(["userId", "type", "payload", "readAt", "createdAt"])
        && d.readAt == null
        && d.createdAt == request.time
        && d.userId is string
        && d.userId != request.auth.uid
        && d.payload.keys().hasOnly(["inviteId", "fromUserId", "fromHandle"])
        && d.payload.fromUserId == request.auth.uid
        && d.payload.fromHandle == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle
        && acceptsInvite(d.payload.inviteId, d.userId);
    }
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && !blockedBetween(request.auth.uid, request.resource.data.userId)
        && inviteAcceptedBell(request.resource.data);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && changedKeys().hasOnly(["readAt"]);
      allow delete: if false;
    }

    // --- quotas (legacy) ---
    // The daily invite counter; invites are gone, and nothing reads these.
    match /quotas/{quotaId} {
      allow read, write: if false;
    }

    // --- reports (檢舉) ---
    // Write-only for clients: a signed-in user files a report about a card, a
    // user, or a message. Nobody can read reports from the client (not even
    // the reporter) — moderation reads them with the Admin SDK
    // (scripts/moderation/reports.ts).
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "reporterId", "targetType", "targetId", "targetUserId",
          "reason", "detail", "contextId", "createdAt", "status"
        ])
        && request.resource.data.keys().hasAll([
          "reporterId", "targetType", "targetId", "targetUserId",
          "reason", "detail", "createdAt", "status"
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ["card", "user", "message"]
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 200
        && request.resource.data.targetUserId is string
        && request.resource.data.targetUserId != request.auth.uid
        && request.resource.data.reason in [
          "spam", "harassment", "hate", "sexual", "self_harm", "violence", "other"
        ]
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 1000
        && (!("contextId" in request.resource.data)
            || (request.resource.data.contextId is string
                && request.resource.data.contextId.size() <= 200))
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == "open";
    }

    // --- account deletion requests (server-only) ---
    // Written by /api/account/deletion with the Admin SDK; purged by the
    // daily cron. Clients never touch them.
    match /accountDeletions/{userId} {
      allow read, write: if false;
    }

    // --- rate limits (server-only) ---
    // Per-user counters the API keeps for its costly or far-reaching
    // endpoints (src/lib/api/rateLimit.ts). Clients never see or touch them.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // --- recommendation engine (server-only) ---
    // cardVectors / userProfiles / recommendations are written and read solely
    // by the Admin SDK (which bypasses these rules). They hold the insight
    // vectors, per-user profile centroids, and cached feeds — including data
    // derived from PRIVATE cards. The client must never touch them: a private
    // card's vector feeds only its own author's profile and is hard-filtered
    // out of everyone else's retrieval at query time. Deny all client access so
    // that boundary can't be probed.
    match /cardVectors/{docId} {
      allow read, write: if false;
    }
    match /userProfiles/{userId} {
      allow read, write: if false;
    }
    match /recommendations/{userId} {
      allow read, write: if false;
    }
  }
}
