{
  "name": "resonance",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "dev:emulator": "node scripts/dev-emulator.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:emulator": "cd firebase && firebase emulators:exec --only auth,firestore --project demo-resonance 'cd .. && vitest run -c vitest.emulator.config.ts'",
    "emulators": "cd firebase && firebase emulators:start --only auth,firestore --project demo-resonance",
    "emulators:at": "node scripts/emulators-at.mjs",
    "moderation": "tsx scripts/moderation/reports.ts",
    "api:openapi": "tsx scripts/api-openapi.ts",
    "native:editor": "tsc -p native/editor/tsconfig.json && node scripts/native/build-editor.mjs",
    "apps:generate": "tsx scripts/native/tokens.ts && tsx scripts/apps/l10n.ts && tsx scripts/apps/icons.ts && npm run -s api:openapi && npm run -s native:editor"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1055.0",
    "@aws-sdk/s3-request-presigner": "^3.1055.0",
    "@tiptap/extension-blockquote": "^3.25.0",
    "@tiptap/extension-image": "^3.25.0",
    "@tiptap/extension-paragraph": "^3.27.3",
    "@tiptap/extension-placeholder": "^3.24.0",
    "@tiptap/pm": "^3.24.0",
    "@tiptap/react": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "mdast-util-from-markdown": "^2.0.3",
    "next": "^15.1.0",
    "next-intl": "^3.26.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "swr": "^2.4.1",
    "tiptap-markdown": "^0.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.18",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.3",
    "typescript": "^5.7.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.1.5",
    "@rolldown/binding-darwin-x64": "^1.1.5",
    "@rolldown/binding-linux-arm64-gnu": "^1.1.5",
    "@rolldown/binding-linux-x64-gnu": "^1.1.5",
    "@rolldown/binding-win32-x64-msvc": "^1.1.5"
  }
}
