{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["hkg1"],
  "functions": {
    "src/app/api/cards/insight/route.ts": { "regions": ["hnd1"], "maxDuration": 60 },
    "src/app/api/cards/tags/route.ts": { "regions": ["hnd1"] },
    "src/app/api/generate-image/route.ts": { "regions": ["hnd1"], "maxDuration": 120 },
    "src/app/api/recommend/feed/route.ts": { "regions": ["hnd1"], "maxDuration": 60 },
    "src/app/api/v1/cards/*/edits/apply/route.ts": { "regions": ["hnd1"], "maxDuration": 60 },
    "src/app/api/v1/cards/*/publish/route.ts": { "regions": ["hnd1"], "maxDuration": 60 },
    "src/app/api/v1/feed/recommended/route.ts": { "regions": ["hnd1"], "maxDuration": 60 }
  },
  "redirects": [
    {
      "source": "/:path((?!(?:api|_next|\\.well-known)(?:/|$)).*)",
      "has": [{ "type": "host", "value": "resonance-world.vercel.app" }],
      "destination": "https://resonance.channel/:path*",
      "permanent": true
    }
  ],
  "github": {
    "silent": true
  },
  "crons": [{ "path": "/api/cron/purge-accounts", "schedule": "0 18 * * *" }]
}
