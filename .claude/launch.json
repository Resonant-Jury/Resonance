{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "docs-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4173", "-d", "docs"],
      "port": 4173
    },
    {
      "name": "dev-emulator",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:emulator", "--", "--port", "3100"],
      "port": 3100
    },
    {
      "name": "native-static",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/native/serve-static.mjs", "4180"],
      "port": 4180
    }
  ]
}