{
  "openapi": "3.0.3",
  "info": {
    "title": "Resonance API",
    "version": "1.0.0",
    "description": "The versioned API for the native apps. Authenticate with `Authorization: Bearer <Firebase ID token>` (the web uses its session cookie). Additive changes only within v1."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "firebaseIdToken": []
    }
  ],
  "paths": {
    "/me": {
      "get": {
        "operationId": "getMe",
        "summary": "The signed-in account",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/feed": {
      "get": {
        "operationId": "getFeed",
        "summary": "Latest public cards, newest first (authors you blocked are left out)",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "default": 12
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedPage"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/feed/recommended": {
      "get": {
        "operationId": "getRecommendedFeed",
        "summary": "Today's picks for you, each with the reason it was picked",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardList"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/cards/{key}": {
      "get": {
        "operationId": "getCard",
        "summary": "A card you may read, by slug or id, with its story",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "The card slug, or (older cards) its id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardDetail"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/cards/{key}/resonances": {
      "get": {
        "operationId": "getCardResonances",
        "summary": "Public cards written in response to this one",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "The card id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardList"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/cards/{key}/related": {
      "get": {
        "operationId": "getRelatedCards",
        "summary": "A few recent cards sharing its tags",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "The card id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardList"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/cards/{key}/links": {
      "get": {
        "operationId": "getCardLinks",
        "summary": "Cards linking to it (empty unless you wrote it)",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "The card id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardList"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/users/{handle}": {
      "get": {
        "operationId": "getProfile",
        "summary": "A person's profile as you see it",
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "description": "Pen name (any script)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/users/{handle}/cards": {
      "get": {
        "operationId": "getProfileCards",
        "summary": "Their public cards, newest first (never anonymous ones)",
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "description": "Pen name (any script)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "default": 12
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedPage"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/users/{handle}/links": {
      "get": {
        "operationId": "getProfileLinks",
        "summary": "Cards by others that link to theirs",
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "description": "Pen name (any script)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardList"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/invites": {
      "post": {
        "operationId": "createInvite",
        "summary": "Invite someone to connect (3 a day)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInviteRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateInviteResponse"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "firebaseIdToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Firebase ID token"
      }
    },
    "schemas": {
      "ErrorCode": {
        "type": "string",
        "enum": [
          "unauthenticated",
          "invalid_request",
          "forbidden",
          "blocked",
          "not_found",
          "conflict",
          "rate_limited",
          "internal"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string"
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "message"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ],
        "description": "Every non-2xx response has this shape."
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "initials": {
            "type": "string"
          },
          "accentColor": {
            "type": "string"
          },
          "bio": {
            "nullable": true,
            "type": "string"
          },
          "avatarUrl": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "handle",
          "initials",
          "accentColor",
          "bio",
          "avatarUrl"
        ],
        "description": "The signed-in account."
      },
      "Author": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "initials": {
            "type": "string"
          },
          "accentColor": {
            "type": "string"
          },
          "avatarUrl": {
            "nullable": true,
            "type": "string"
          },
          "avatarSeed": {
            "nullable": true,
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "region": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "handle",
          "initials",
          "accentColor",
          "avatarUrl",
          "avatarSeed",
          "verified",
          "region"
        ]
      },
      "FeedCard": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "nullable": true,
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "publishedAt": {
            "type": "string",
            "description": "ISO 8601"
          },
          "author": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Author"
              }
            ]
          },
          "imageUrl": {
            "nullable": true,
            "type": "string"
          },
          "imageLabel": {
            "nullable": true,
            "type": "string"
          },
          "accentHue": {
            "nullable": true,
            "type": "number"
          },
          "readMinutes": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "referenceCardId": {
            "nullable": true,
            "type": "string"
          },
          "reason": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "excerpt",
          "tags",
          "publishedAt",
          "author",
          "imageUrl",
          "imageLabel",
          "accentHue",
          "readMinutes",
          "referenceCardId",
          "reason"
        ]
      },
      "FeedPage": {
        "type": "object",
        "properties": {
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedCard"
            }
          },
          "nextCursor": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "cards",
          "nextCursor"
        ]
      },
      "CardList": {
        "type": "object",
        "properties": {
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedCard"
            }
          }
        },
        "required": [
          "cards"
        ]
      },
      "CardDetail": {
        "type": "object",
        "properties": {
          "card": {
            "$ref": "#/components/schemas/FeedCard"
          },
          "story": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "connections",
              "private"
            ]
          },
          "anonymous": {
            "type": "boolean"
          },
          "resonanceCount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "coreInsight": {
            "nullable": true,
            "type": "string"
          },
          "isOwner": {
            "type": "boolean"
          },
          "referenceCard": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/FeedCard"
              }
            ]
          }
        },
        "required": [
          "card",
          "story",
          "visibility",
          "anonymous",
          "resonanceCount",
          "coreInsight",
          "isOwner",
          "referenceCard"
        ]
      },
      "Profile": {
        "type": "object",
        "properties": {
          "author": {
            "$ref": "#/components/schemas/Author"
          },
          "bio": {
            "nullable": true,
            "type": "string"
          },
          "joinedAt": {
            "type": "string",
            "description": "ISO 8601"
          },
          "cardCount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "isSelf": {
            "type": "boolean"
          },
          "isConnected": {
            "type": "boolean"
          },
          "isBlocked": {
            "type": "boolean"
          }
        },
        "required": [
          "author",
          "bio",
          "joinedAt",
          "cardCount",
          "isSelf",
          "isConnected",
          "isBlocked"
        ]
      },
      "CreateInviteRequest": {
        "type": "object",
        "properties": {
          "toUserId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "referenceCardId": {
            "nullable": true,
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        },
        "required": [
          "toUserId",
          "message"
        ]
      },
      "CreateInviteResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    }
  }
}
