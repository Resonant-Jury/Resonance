# Android release signing (back up the keystore privately; never commit)
android/keystore.properties
*.keystore

# Firebase emulator logs
*-debug.log

# Native spikes (native/): build outputs and generated projects
native/**/.build/
native/**/build/
native/**/.gradle/
native/**/local.properties
native/**/*.xcodeproj/
native/**/DerivedData/
native/**/.kotlin/
native/fixtures/*.local.json
native/fonts/
.venv-fonts/
native/editor/dist/

# Native apps (apps/): generated Xcode project, build outputs, SwiftPM caches
apps/ios/*.xcodeproj/
apps/ios/build/
apps/**/.build/
apps/**/.swiftpm/
# Android (apps/android): Gradle caches and build outputs, this machine's SDK path
apps/android/.gradle/
apps/android/.kotlin/
apps/android/**/build/
apps/android/local.properties
