<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Push (API 33+ asks at run time, once the person is signed in). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The in-app browser picks a browser to run the page in (never this app, see InAppBrowser). -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".ResonanceApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Resonance"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <!-- singleTop: a site link (or the debug route) opened while the app is
                 running arrives in onNewIntent instead of being dropped. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Site links open in the app (public/.well-known/assetlinks.json verifies them,
                 for the Play key, the upload key and the debug key alike) — only the pages the
                 app shows itself (Route.fromPath: /card/…, /u/…, /messages/…, /me/thought-map,
                 bare or under a locale). Everything else on the site, the policy pages first,
                 stays with the browser, so the in-app browser can show it. Both of the site's
                 hosts serve the same file: its own domain, and the one it had before
                 (StoryLink.FORMER_HOSTS), whose links are in older stories and messages. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="resonance.channel" />
                <data android:host="resonance-world.vercel.app" />
                <data android:pathPrefix="/card/" />
                <data android:pathPrefix="/u/" />
                <data android:pathPrefix="/messages/" />
                <data android:pathPrefix="/me/thought-map" />
                <data android:pathPrefix="/en/card/" />
                <data android:pathPrefix="/en/u/" />
                <data android:pathPrefix="/en/messages/" />
                <data android:pathPrefix="/en/me/thought-map" />
                <data android:pathPrefix="/zh-TW/card/" />
                <data android:pathPrefix="/zh-TW/u/" />
                <data android:pathPrefix="/zh-TW/messages/" />
                <data android:pathPrefix="/zh-TW/me/thought-map" />
            </intent-filter>
        </activity>

        <!-- Push: a new FCM token, and messages that arrive while the app is open (see PushCenter). -->
        <service android:name=".ResonancePushService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- What the system shows for a push while the app is closed: the "activity" channel and the waves glyph. -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="activity" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_notification" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/notification_accent" />
        <!-- Off until the app turns it on (PushCenter.start): emulator builds never touch FCM, their Firebase project is a stand-in. -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
    </application>
</manifest>
